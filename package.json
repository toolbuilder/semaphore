{
  "name": "@toolbuilder/semaphore",
  "version": "0.1.7",
  "description": "Basic semaphore and mutex with both sync and async acquire methods.",
  "keywords": [
    "semaphore",
    "mutex",
    "acquire",
    "async"
  ],
  "homepage": "https://github.com/toolbuilder/semaphore#readme",
  "bugs": {
    "url": "https://github.com/toolbuilder/semaphore/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toolbuilder/semaphore.git"
  },
  "sideEffects": false,
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:types": "tsc",
    "test": "node --test 'test/**/*.test.js'",
    "check": "pnpm run check:types && pnpm run build && pnpm test",
    "validate:package": "npx -y publint && npx -y @arethetypeswrong/cli --pack . --profile esm-only",
    "release": "commit-and-tag-version"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "commit-and-tag-version": "^12.5.0",
    "typescript": "^5.6.3"
  }
}
